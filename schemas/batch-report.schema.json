{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/medthemed/carbon-model-router/schemas/batch-report.schema.json",
  "title": "carbon-model-router batch route report",
  "description": "Stable stdout contract for `cmr route-file --format json`.",
  "type": "object",
  "required": ["items", "summary"],
  "additionalProperties": true,
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "model_id", "estimated_cost", "estimated_energy_kwh", "default_model_id", "saved_cost", "saved_energy_kwh"],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "prompt_preview": { "type": "string" },
          "model_id": { "type": "string" },
          "estimated_tokens": { "type": "integer", "minimum": 0 },
          "estimated_cost": { "type": "number", "minimum": 0 },
          "estimated_energy_kwh": { "type": "number", "minimum": 0 },
          "default_model_id": { "type": "string" },
          "default_cost": { "type": "number", "minimum": 0 },
          "default_energy_kwh": { "type": "number", "minimum": 0 },
          "saved_cost": { "type": "number" },
          "saved_energy_kwh": { "type": "number" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "complexity": { "type": "object" },
          "rationale": { "type": "string" }
        }
      }
    },
    "summary": {
      "type": ["object", "null"],
      "required": ["prompt_count", "routed_cost", "default_cost", "saved_cost", "saved_cost_pct", "saved_energy_kwh", "saved_energy_pct", "default_model_id"],
      "properties": {
        "prompt_count": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 },
        "routed_cost": { "type": "number", "minimum": 0 },
        "routed_energy_kwh": { "type": "number", "minimum": 0 },
        "default_cost": { "type": "number", "minimum": 0 },
        "default_energy_kwh": { "type": "number", "minimum": 0 },
        "default_model_id": { "type": "string" },
        "saved_cost": { "type": "number" },
        "saved_energy_kwh": { "type": "number" },
        "saved_cost_pct": { "type": "number" },
        "saved_energy_pct": { "type": "number" }
      }
    }
  }
}
